# Unreal binary assets go through Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
Art/Beacon/*.fbx filter=lfs diff=lfs merge=lfs -text
Art/Beacon/*.png filter=lfs diff=lfs merge=lfs -text

# Text files use LF in the working tree on every platform
.gitattributes text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
